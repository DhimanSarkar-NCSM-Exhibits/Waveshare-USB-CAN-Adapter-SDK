# ------------------------------------------------------------
# VS Code
# ------------------------------------------------------------

# Keep project-specific VS Code configuration
# Ignore only temporary/editor-specific files
.vscode/*.log
.vscode/*.tmp
.vscode/.ropeproject/

# Workspace backups
*.code-workspace.backup

# VS Code history
.history/

